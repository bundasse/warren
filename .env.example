# 이 파일을 복사해서 `.env`로 만들고 값을 채우세요.
#   PowerShell: Copy-Item .env.example .env
#
# Vite는 `VITE_` 접두사가 붙은 변수만 브라우저 번들에 노출합니다.
# `VITE_FIREBASE_API_KEY` 등은 '비밀 키'가 아니라 앱 식별자입니다(공개되어도 됨).
# 다만 Firestore 보안 규칙은 반드시 설정해야 데이터가 보호됩니다.

# mock(localStorage) 백엔드 사용 여부
#   true  -> Firebase 키 없이 개발 (기본값, 권장)
#   false -> 실제 Firestore 사용
VITE_USE_MOCK=true

# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성 에서 복사
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
